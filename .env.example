# BenchZero Environment Configuration Example
SECRET_KEY=django-insecure-benchzero-optimized-staffing-allocation-engine-key
DEBUG=True
ALLOWED_HOSTS=*
DATABASE_URL=sqlite:///db.sqlite3

# Set to True before exposing BenchZero beyond localhost. When True, every
# mutating endpoint (create/update/delete + accept/reject/cancel/approve
# actions) requires a logged-in user; reads stay open either way. Create
# at least one user first: python manage.py createsuperuser
REQUIRE_AUTH_FOR_WRITES=False
