# BenchZero Environment Configuration Example
SECRET_KEY=django-insecure-benchzero-optimized-staffing-allocation-engine-key
DEBUG=True
ALLOWED_HOSTS=*
DATABASE_URL=sqlite:///db.sqlite3

# Set REQUIRE_AUTH_FOR_WRITES=True (secure default). Every mutating endpoint
# (create/update/delete + accept/reject/cancel/approve actions) requires an
# authenticated user; reads stay open either way. Set to False only for local
# zero-config interactive demo testing without login. Create at least one user:
# python manage.py createsuperuser
REQUIRE_AUTH_FOR_WRITES=True

